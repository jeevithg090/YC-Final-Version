# Copy to `.env` and fill in. Never commit `.env`.
#
# NOTE: every EXPO_PUBLIC_* value is inlined into the app bundle at build time
# and can be extracted by anyone with the app. Only use keys that are safe to
# expose to clients (Firebase web config is designed for this), and restrict
# third-party keys by quota/referrer where the provider allows it.

# --- Firebase (required) -----------------------------------------------------
# Firebase console > Project settings > Your apps > Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional (Google Analytics)
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Optional integrations ---------------------------------------------------
# Features degrade gracefully when these are blank. Keys can also be stored in
# the Firestore document `api_keys/keys` (see firestore-data/api_keys.json).

# OpenRouter: AI assistant and bill parsing fallback (https://openrouter.ai)
EXPO_PUBLIC_OPENROUTER_API_KEY=
# OCR.space: receipt text extraction (https://ocr.space/ocrapi)
EXPO_PUBLIC_OCR_API_KEY=
# Google Gemini: timetable extraction from images (https://aistudio.google.com)
EXPO_PUBLIC_GEMINI_API_KEY=
# Tavus: video assistant (https://tavus.io)
EXPO_PUBLIC_TAVUS_API_KEY=
# WeatherAPI: live weather on the Weather screen (https://www.weatherapi.com)
EXPO_PUBLIC_WEATHER_API_KEY=
