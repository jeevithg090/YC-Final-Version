{
  "expo": {
    "name": "YOGO",
    "slug": "YOGO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yogo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.jeevithg.YOGO",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A53AC"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jeevithg.YOGO"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "YOGO Campus",
      "shortName": "YOGO",
      "description": "All-in-one campus companion for students: mess menus, ride sharing, a marketplace, bill splitting, timetables, Q&A and more.",
      "themeColor": "#4E54C8",
      "backgroundColor": "#F6F7FB"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A53AC"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4E54C8",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "947c91e1-d066-4c95-b146-2af872ad41ee"
      }
    }
  }
}
